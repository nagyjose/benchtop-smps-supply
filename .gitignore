# ==============================================================================
# .gitignore for Autodesk Eagle PCB Project - benchtop-smps-supply
# ==============================================================================

# Autodesk Eagle CAD backups and autosaves
*.s#*
*.b#*
*.l#*

# Eagle project desktop state and lock files
*.epf
*.lck

# Operating system files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary and editor files
*.tmp
*~
*.bak
